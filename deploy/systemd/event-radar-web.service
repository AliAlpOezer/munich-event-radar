[Unit]
Description=Munich event radar web app (ADR 0002), Tailscale only
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=eventradar
Group=eventradar
EnvironmentFile=/etc/event-radar/env
ExecStart=/opt/event-radar/.venv/bin/python -m event_radar.web --host ${RADAR_WEB_HOST} --port 8010
Restart=on-failure
RestartSec=10
MemoryMax=300M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/event-radar

[Install]
WantedBy=multi-user.target
