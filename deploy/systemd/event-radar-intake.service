[Unit]
Description=Munich event radar intake worker (ADR 0005)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eventradar
Group=eventradar
EnvironmentFile=/etc/event-radar/env
ExecStart=/opt/event-radar/.venv/bin/event-radar intake-worker
# Crash-only: a lost database session ends the process and the next start requeues its work.
Restart=always
RestartSec=10
MemoryMax=700M
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/event-radar

[Install]
WantedBy=multi-user.target
